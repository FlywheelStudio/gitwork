{
  "name": "gitwork",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @gitwork/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter @gitwork/web test:e2e",
    "smoke": "./scripts/smoke.sh",
    "db:migrate": "pnpm --filter @gitwork/web db:migrate",
    "db:generate": "pnpm --filter @gitwork/db generate",
    "preview": "pnpm --filter @gitwork/web preview"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "5.0.4"
  }
}

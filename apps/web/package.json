{
  "name": "@gitwork/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "cf:build": "GITWORK_TARGET=cloudflare opennextjs-cloudflare build",
    "preview": "pnpm cf:build && pnpm cf:migrate:local && opennextjs-cloudflare preview",
    "predev": "pnpm db:migrate",
    "db:migrate": "tsx ../../packages/db/src/migrate-cli.ts",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@gitwork/core": "workspace:*",
    "@gitwork/db": "workspace:*",
    "@opennextjs/cloudflare": "1.20.11",
    "better-auth": "1.7.8",
    "drizzle-orm": "0.45.4",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "wrangler": "4.151.0"
  },
  "license": "AGPL-3.0-only"
}

{
  "name": "@gitwork/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "cf:build": "GITWORK_TARGET=cloudflare opennextjs-cloudflare build",
    "preview": "pnpm cf:build && pnpm cf:migrate:local && opennextjs-cloudflare preview",
    "predev": "pnpm db:migrate",
    "db:migrate": "tsx ../../packages/db/src/migrate-cli.ts",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:deploy": "pnpm cf:build && wrangler d1 migrations apply DB --remote && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@gitwork/core": "workspace:*",
    "@gitwork/db": "workspace:*",
    "@gitwork/server": "workspace:*",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "@opennextjs/cloudflare": "1.20.11",
    "better-auth": "1.7.8",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.57.0",
    "next": "16.3.8",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "shadcn": "4.21.4",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "wrangler": "4.151.0"
  },
  "license": "AGPL-3.0-only"
}

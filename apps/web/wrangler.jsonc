{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "gitwork",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Reconcile with GitHub every 15 minutes (decision 010).
  "triggers": { "crons": ["*/15 * * * *"] },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gitwork",
      // Local placeholder. Before deploying, run `wrangler d1 create gitwork` and paste the real ID.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Cloudflare Email Service for sign-in codes and invites.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "EMAIL_TRANSPORT": "cloudflare",
    // Must use a domain onboarded to Cloudflare Email Service.
    "EMAIL_FROM": "Gitwork <no-reply@example.com>"
  },
  "services": [
    {
      // Self-reference binding. The service name must match the worker name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gitwork"
    }
  ]
}

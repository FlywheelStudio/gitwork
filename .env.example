# Node hosts: copy to apps/web/.env.local. Cloudflare: put secrets in apps/web/.dev.vars locally
# and in `wrangler secret put` for deploys. The database on Cloudflare is the D1 binding in
# wrangler.jsonc.

# libsql URL of the SQLite database (Node hosts only). Relative paths resolve from apps/web.
DATABASE_URL=file:.data/gitwork.sqlite

# Instance admins: these emails can open /setup, create the GitHub App, and always sign up.
INSTANCE_ADMIN_EMAILS=you@example.com

# Better Auth. Both are required in production. Generate the secret with: openssl rand -base64 32
# The secret also encrypts the stored GitHub App credentials and linked GitHub tokens: rotating it
# means re-running /setup and every user linking GitHub again.
BETTER_AUTH_SECRET=
# The public URL of this instance. Email links and the same-origin check use it.
BETTER_AUTH_URL=http://localhost:3000

# Node hosts behind a reverse proxy: the header that carries the real client IP (e.g. x-real-ip).
# Set it only if the proxy always overwrites that header. Unset = no per-IP limits; per-email
# limits still apply. Cloudflare Workers use cf-connecting-ip automatically.
TRUSTED_IP_HEADER=

# Email for sign-in codes: console (dev only) | smtp (Node) | cloudflare (Workers)
EMAIL_TRANSPORT=console
EMAIL_FROM=Gitwork <no-reply@example.com>
SMTP_URL=

# GitHub App. Leave empty and use /setup to create one (stored encrypted in the database), or set
# all five to use an existing App (the hosted version does this). Use \n for newlines in the key.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Node hosts reconcile with GitHub every 15 minutes in-process. Set to "off" to disable.
# Cloudflare uses the Cron Trigger in wrangler.jsonc instead.
GITWORK_SCHEDULER=
# Reconcile budget per run (defaults 3 targets, 10 GitHub pages each). Lower them on the Workers
# Free plan, which allows 50 subrequests per invocation.
RECONCILE_MAX_TARGETS=
RECONCILE_MAX_PAGES=
